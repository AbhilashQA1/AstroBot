{
  "schema": "astrobot/rules@1",
  "family": "planet-in-house",
  "about": "The Moon in each of the twelve bhavas. Readings assume a waxing Moon; the engine weakens them when the Moon is marked as near the Sun.",
  "rules": [
    { "id": "pih.mo.1", "when": { "planetInHouse": { "planet": "mo", "house": 1 } },
      "says": "The mind sits in front of everything else: responsive, changeable, easy to like, and visibly affected by whatever is in the room.",
      "themes": ["self", "mind"], "polarity": "mixed", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.9, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.2", "when": { "planetInHouse": { "planet": "mo", "house": 2 } },
      "says": "Money arrives and leaves in tides rather than a steady line; speech is warm and persuasive, and food matters more than most would admit.",
      "themes": ["wealth", "speech"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "saravali", "locus": "ch. 21" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.3", "when": { "planetInHouse": { "planet": "mo", "house": 3 } },
      "says": "Restless and quick to move; siblings, especially sisters, are close, and short journeys are frequent.",
      "themes": ["effort", "siblings"], "polarity": "mixed", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }],
      "confidence": 0.8, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.4", "when": { "planetInHouse": { "planet": "mo", "house": 4 } },
      "says": "Home is the source of strength: a strong bond with the mother, comfort in a place of their own, and a real attachment to land and vehicles.",
      "themes": ["home", "mother", "comfort"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.95, "status": "active", "added": "2026-11-04",
      "note": "The 4th is also the Moon's own quarter of the chart, so it acts here at full strength." },
    { "id": "pih.mo.5", "when": { "planetInHouse": { "planet": "mo", "house": 5 } },
      "says": "Affection and imagination run together: fond of children, drawn to making things, and romantic by temperament.",
      "themes": ["children", "intellect", "romance"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "saravali", "locus": "ch. 21" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.6", "when": { "planetInHouse": { "planet": "mo", "house": 6 } },
      "says": "Worry settles in the body; digestion and sleep register stress first, and service is given more readily than it is asked for.",
      "themes": ["adversity", "health", "mind"], "polarity": "difficult", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.7", "when": { "planetInHouse": { "planet": "mo", "house": 7 } },
      "says": "The partner shapes the mood of the whole life; charming in company, and uneasy when alone.",
      "themes": ["partnership", "mind"], "polarity": "mixed", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "saravali", "locus": "ch. 21" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.8", "when": { "planetInHouse": { "planet": "mo", "house": 8 } },
      "says": "Feeling runs deep and unquiet: drawn to what is hidden, prone to carrying fear privately, and marked by the losses it has seen.",
      "themes": ["rupture", "mind", "occult"], "polarity": "difficult", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.9", "when": { "planetInHouse": { "planet": "mo", "house": 9 } },
      "says": "Belief is felt rather than argued; devotion comes easily, travel is fortunate, and sympathies are wide.",
      "themes": ["fortune", "faith"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "saravali", "locus": "ch. 21" }],
      "confidence": 0.9, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.10", "when": { "planetInHouse": { "planet": "mo", "house": 10 } },
      "says": "Work that faces the public suits this placement; the career moves in phases and popularity is part of the job.",
      "themes": ["work", "status"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.11", "when": { "planetInHouse": { "planet": "mo", "house": 11 } },
      "says": "A wide circle and income that comes through people; friendships are many and genuinely useful.",
      "themes": ["gain", "friends"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.9, "status": "active", "added": "2026-11-04" },
    { "id": "pih.mo.12", "when": { "planetInHouse": { "planet": "mo", "house": 12 } },
      "says": "The inner life is larger than the outer one: vivid dreams, time spent apart from others, foreign places, and real compassion.",
      "themes": ["loss", "foreign", "mind"], "polarity": "mixed", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 12" }, { "key": "saravali", "locus": "ch. 21" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" }
  ]
}
