{
  "schema": "astrobot/rules@1",
  "family": "planet-in-house",
  "about": "The Sun in each of the twelve bhavas. Parashari mainstream.",
  "rules": [
    { "id": "pih.su.1", "when": { "planetInHouse": { "planet": "su", "house": 1 } },
      "says": "Identity is built on being seen and taken seriously; confident and impatient, with heat showing in the constitution and often in the eyes or scalp.",
      "themes": ["self", "health"], "polarity": "mixed", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.9, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.2", "when": { "planetInHouse": { "planet": "su", "house": 2 } },
      "says": "Money comes through position and standing rather than trade; speech carries authority and can land as blunt.",
      "themes": ["wealth", "speech"], "polarity": "mixed", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "saravali", "locus": "ch. 20" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.3", "when": { "planetInHouse": { "planet": "su", "house": 3 } },
      "says": "Effort is rewarded and rivals are outlasted; relations with younger siblings stay few or formal.",
      "themes": ["effort", "siblings"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.4", "when": { "planetInHouse": { "planet": "su", "house": 4 } },
      "says": "Home is where the person is least at rest; distance from the mother or the birthplace is common, and status is sought outside the house.",
      "themes": ["home", "mother"], "polarity": "difficult", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "saravali", "locus": "ch. 20" }],
      "confidence": 0.8, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.5", "when": { "planetInHouse": { "planet": "su", "house": 5 } },
      "says": "Sharp, authoritative intelligence that rises through its own judgement; matters of children ask for patience, and speculation is a poor use of it.",
      "themes": ["intellect", "children"], "polarity": "mixed", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.8, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.6", "when": { "planetInHouse": { "planet": "su", "house": 6 } },
      "says": "Opposition does not hold against this placement: disputes are won, service is commanding, and recovery from illness is quick.",
      "themes": ["adversity", "health"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "saravali", "locus": "ch. 20" }],
      "confidence": 0.9, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.7", "when": { "planetInHouse": { "planet": "su", "house": 7 } },
      "says": "Partnership meets a will that does not bend easily; the spouse is proud or independent, and standing can be spent in open dealings.",
      "themes": ["partnership", "status"], "polarity": "difficult", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.8", "when": { "planetInHouse": { "planet": "su", "house": 8 } },
      "says": "Draws the person towards what is hidden, chronic or inherited; vitality runs unevenly and legacies arrive late.",
      "themes": ["rupture", "longevity"], "polarity": "difficult", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }],
      "confidence": 0.75, "status": "active", "added": "2026-11-04",
      "note": "Some classical authorities read the Sun in the 8th as granting long life rather than shortening it. Both readings are held; see pih.su.8.alt." },
    { "id": "pih.su.8.alt", "when": { "planetInHouse": { "planet": "su", "house": 8 } },
      "says": "A minority classical reading grants long life from this placement, the 8th being the house of longevity itself.",
      "themes": ["longevity"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "saravali", "locus": "ch. 20" }],
      "confidence": 0.4, "status": "disputed", "conflictsWith": ["pih.su.8"], "added": "2026-11-04" },
    { "id": "pih.su.9", "when": { "planetInHouse": { "planet": "su", "house": 9 } },
      "says": "Fortune arrives through principle: a strong line to the father or teacher, and belief that is acted on rather than merely held.",
      "themes": ["fortune", "father", "faith"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.9, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.10", "when": { "planetInHouse": { "planet": "su", "house": 10 } },
      "says": "Work is the arena where this person becomes visible; authority is held comfortably and reputation is earned in public.",
      "themes": ["work", "status"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "saravali", "locus": "ch. 20" }],
      "confidence": 0.95, "status": "active", "added": "2026-11-04",
      "note": "The 10th is also the Sun's own quarter of the chart, so it acts here at full strength." },
    { "id": "pih.su.11", "when": { "planetInHouse": { "planet": "su", "house": 11 } },
      "says": "Income is steady and comes from those in charge; ambitions tend to be met, and elder siblings or patrons help.",
      "themes": ["gain", "siblings"], "polarity": "favourable", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "phaladeepika", "locus": "ch. 10" }],
      "confidence": 0.9, "status": "active", "added": "2026-11-04" },
    { "id": "pih.su.12", "when": { "planetInHouse": { "planet": "su", "house": 12 } },
      "says": "Standing is spent rather than displayed: life abroad, work behind the scenes, or a turn inward; the eyes and the father both ask for care.",
      "themes": ["loss", "foreign", "father"], "polarity": "difficult", "tradition": "parashari",
      "sources": [{ "key": "bphs", "locus": "ch. 11" }, { "key": "saravali", "locus": "ch. 20" }],
      "confidence": 0.85, "status": "active", "added": "2026-11-04" }
  ]
}
